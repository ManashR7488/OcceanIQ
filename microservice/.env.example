# ========================================
# LLM Configuration (Data Chat Feature)
# ========================================
# Dual-LLM System with Automatic Fallback
# - Primary LLM handles all chat requests
# - Secondary LLM provides automatic fallback if primary fails
# - Retry logic: 2 attempts per LLM with exponential backoff
# - Timeout: 90 seconds per request

# OpenAI API Key (GPT-4o-mini - cost-optimized, fast responses)
# Also used for Vision API in Taxonomy Identification
OPENAI_API_KEY=your-openai-api-key-here

# Google AI API Key (Gemini 2.0 Flash Exp - high performance fallback)
GOOGLE_API_KEY=your-google-api-key-here

# Preferred LLM Provider (default: openai)
# Options: "openai" | "gemini"
# - Sets which LLM to use as primary
# - Other LLM automatically becomes fallback
# - Both keys should be configured for high availability
PREFERRED_LLM=openai

# Strict LLM Configuration (default: false)
# Options: "true" | "false"
# - true: Service refuses to start if no API keys configured (production mode)
# - false: Service starts without LLM, requests fail gracefully with clear error (dev mode)
# Recommended: Set to "true" in production to catch missing credentials at startup
STRICT_LLM_CONFIG=false

# ========================================
# Research Agent Configuration
# ========================================
# Tavily Search API Key (for research agent)
TAVILY_API_KEY=your-tavily-api-key-here

# Embedding Model Configuration (FREE - no API key needed!)
# Uses Sentence Transformers from HuggingFace
# Default: sentence-transformers/all-MiniLM-L6-v2 (lightweight, fast)
# Alternatives: 
#   - all-mpnet-base-v2 (better quality, slower)
#   - paraphrase-multilingual-MiniLM-L12-v2 (multilingual support)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db

# File Upload Limits
MAX_FILE_SIZE_MB=50

# Chunking Configuration
CHUNK_SIZE_CSV=50
CHUNK_SIZE_JSON=100
CHUNK_SIZE_XML=50
CHUNK_SIZE_NETCDF=10
