# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/occeaniq
# Or use MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/occeaniq?retryWrites=true&w=majority

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# ============================================
# IMAGE STORAGE (CLOUDINARY)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# SPECIES IDENTIFICATION (FISHIAL.AI)
# ============================================
# Sign up at https://fishial.ai to get your credentials
# Fishial.AI provides fish-specific species identification with 639+ species coverage
FISHIAL_CLIENT_ID=your_fishial_client_id_here
FISHIAL_CLIENT_SECRET=your_fishial_client_secret_here

# ============================================
# ADDITIONAL APIs (Optional)
# ============================================
# These are used for other features in the platform
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# ============================================
# AI ANALYTICS CONFIGURATION
# ============================================
# Optional: Required only for natural language query feature (/api/analytics/query)
# If not configured, the query endpoint will return an error message
# Sign up at https://platform.openai.com/ or https://console.anthropic.com/
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3

# ============================================
# PERFORMANCE & OPTIMIZATION
# ============================================
# Redis Configuration (for caching and distributed rate limiting)
# Redis is optional and will fall back to in-memory cache if not configured
# Format: redis://[username]:[password]@[host]:[port]
# Examples:
#   Local: redis://localhost:6379
#   Redis Cloud: redis://:password@redis-12345.c1.us-east-1.ec2.cloud.redislabs.com:12345
#   AWS ElastiCache: redis://master.your-cluster.cache.amazonaws.com:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Set to 'true' for production Redis instances with TLS (e.g., Redis Cloud, AWS ElastiCache)
REDIS_TLS=false

# Caching
CACHE_ENABLED=true
# Cache TTL in milliseconds (default: 5 minutes = 300000ms)
CACHE_TTL=300000

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Logging
# Options: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info
# Options: 'dev' (colored, concise), 'combined' (Apache combined log format)
LOG_FORMAT=combined

# ============================================
# MICROSERVICE CONFIGURATION
# ============================================
# FastAPI microservice URL for taxonomy identification, research, and data chat
# The microservice provides LangGraph-based AI agents for:
#   - Species taxonomy identification (vision + web research)
#   - Deep research document generation
#   - Data chat with uploaded datasets
MICROSERVICE_URL=http://localhost:8000

# ============================================
# N8N TAXONOMY WEBHOOK CONFIGURATION (DEPRECATED)
# ============================================
# LEGACY: This n8n webhook has been replaced by the FastAPI microservice
# The taxonomy identification now uses /taxonomy-identify endpoint in the microservice
# Kept for reference only - can be removed after confirming migration
#
# n8n webhook URL for species taxonomy identification
# This webhook receives either a species name or image URL and returns
# comprehensive taxonomy data including scientific name, common names,
# taxonomic hierarchy, morphology, ecology, habitat, and distribution.
#
# Expected Input Format:
#   POST { "input": "species_name_or_image_url" }
#
# Expected Output Format:
#   {
#     "scientificName": "Gadus morhua",
#     "commonNames": ["Atlantic Cod", "Cod"],
#     "taxonomicHierarchy": { "kingdom": "Animalia", ... },
#     "description": "...",
#     "habitat": "...",
#     "distribution": "...",
#     "morphology": { "maxLength": 200, ... },
#     "ecology": { "diet": "...", ... },
#     "conservationStatus": "Vulnerable",
#     "economicImportance": "...",
#     "imageUrl": "https://...",
#     "thumbnailUrl": "https://...",
#     "externalLinks": { "wikipedia": "...", ... }
#   }
#
# Example: https://your-n8n-instance.com/webhook/taxonomy-identify
# N8N_TAXONOMY_WEBHOOK_URL=https://your-n8n-instance.com/webhook/taxonomy-identify
# N8N_TAXONOMY_TIMEOUT=60000

# ============================================
# N8N Research Agent Configuration
# ============================================
N8N_RESEARCH_WEBHOOK_URL=https://your-n8n-instance.com/webhook/research

# ============================================
# CORS CONFIGURATION
# ============================================
# For production deployment, update this to your frontend URL
CORS_ORIGIN=http://localhost:5173
